# Copy to orchestration/.env and fill in - orchestration/.env is gitignored.
# Same Databricks workspace host as the main project's .env.example - reused so the
# Airflow connection (see the README's "Airflow DAG orchestration" section for how to
# configure it) and DatabricksRunNowOperator both target the same workspace this project's
# Databricks Jobs (databricks.yml) are deployed to.
DATABRICKS_HOST=
